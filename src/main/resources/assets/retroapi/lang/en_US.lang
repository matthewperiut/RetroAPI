# The three variants of block 31, which vanilla labels with one shared name because
# BlockItem.getTranslationKey ignores the stack's damage - see mixin/item/TallPlantItemNameMixin.
# Only reachable once TallPlantBlockMixin.getDroppedItemMeta keeps the variant on the sheared item.
# Loaded by RetroAPI's LangLoader like everything else here. Nothing depends on it being loaded:
# mixin/client/TallPlantNameShimMixin answers these three keys itself when no loader has, so a bare
# install (and StationAPI, which clears the whole translation table on every resource reload) still
# gets a name. These entries win wherever they ARE loaded, which is what makes them translatable.
#
# "Dead Shrub", not "Dead Bush": block 32 is a different block with the same sprite and already owns
# that name.
tile.retrotweaks.dead_shrub.name=Dead Shrub
tile.retrotweaks.short_grass.name=Short Grass
tile.retrotweaks.fern.name=Fern

# Two of VANILLA's own keys, filled in rather than invented: blocks 32 and 31 set them in their
# constructors and lang/en_US.lang translates neither, because neither block was obtainable in
# b1.7.3 so nothing ever looked them up. RetroTweaks makes both obtainable, which turns that into a
# blank tooltip. Same shim covers them when nothing loads this file - see TallPlantNameShimMixin.
tile.deadbush.name=Dead Bush
tile.tallgrass.name=Tall Grass

# The same page names again under StationAPI's key. StationAPI's achievements screen titles a page
# with "gui.stationapi.achievementPage." + the page's own name, and RetroAPI's with its own prefix -
# so a page mirrored onto that screen (StationAchievementPages) needs both, or it draws a raw key on
# exactly one of the two installs.
gui.stationapi.achievementPage.retrotweaks.waysbasic=WAYS: Basic
gui.stationapi.achievementPage.retrotweaks.waysdays=WAYS: Days
gui.stationapi.achievementPage.retrotweaks.ways404=WAYS: 404
